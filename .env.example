# No secrets are needed yet: reviews are stored in the browser (localStorage).
# When reviews move to Supabase (OD-13), copy this file to .env.local and fill in
# values from 1Password > "OpenDish Dev". Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server-only, never prefix with NEXT_PUBLIC_
